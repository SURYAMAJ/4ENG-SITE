{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "4eng-site",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
